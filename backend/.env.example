# woonam-auto-trading — local environment template.
# Copy this file to backend/.env and fill in the values.
# Never commit the real .env. Only this template is tracked in git.

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
RUNTIME_MODE=paper                    # paper | live  (live is gated until Phase 6)
APP_ENV=local                         # local | staging | prod
TIMEZONE=Asia/Seoul                   # operator time zone (display only)
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json | console

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL 16 + TimescaleDB extension)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://woonam:woonam@localhost:5432/woonam
DATABASE_URL_ASYNC=postgresql+asyncpg://woonam:woonam@localhost:5432/woonam
DB_ECHO_SQL=false

# ─────────────────────────────────────────────────────────────
# Auth (JWT)
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (or python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Bootstrap operator (created on first start if no users exist)
BOOTSTRAP_USERNAME=woonam
BOOTSTRAP_PASSWORD=                   # required if no user yet; rotate after first login

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080

# ─────────────────────────────────────────────────────────────
# Data sources — Korea (all free)
# ─────────────────────────────────────────────────────────────
DART_API_KEY=                         # https://opendart.fss.or.kr  (free, instant issue)
BIGKINDS_ACCESS_KEY=                  # https://www.bigkinds.or.kr  (research API, free)
NAVER_CLIENT_ID=                      # https://developers.naver.com  (25,000 calls/day free)
NAVER_CLIENT_SECRET=
BOK_ECOS_API_KEY=                     # https://ecos.bok.or.kr  (free)

# Historical news backfill — set NEWS_BACKFILL_JOB_ID to an identifier
# the scheduler should chip away at (e.g. "2026-backfill-v1"). The
# nightly job (disabled by default) reads NEWS_BACKFILL_WINDOW_DAYS
# back from today's date when resuming.
NEWS_BACKFILL_JOB_ID=
NEWS_BACKFILL_WINDOW_DAYS=365

# ─────────────────────────────────────────────────────────────
# Data sources — US (all free)
# ─────────────────────────────────────────────────────────────
SEC_USER_AGENT=YourName your.email@example.com    # SEC EDGAR requires identifying UA
FRED_API_KEY=                         # https://fred.stlouisfed.org  (free)

# ─────────────────────────────────────────────────────────────
# LLM providers (configure at least one)
# ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:14b
GROQ_API_KEY=                         # https://console.groq.com  (free tier)
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=                       # https://aistudio.google.com  (free tier)
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────────────────────
# MT5 (FX/gold only — not used for equities)
# ─────────────────────────────────────────────────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ─────────────────────────────────────────────────────────────
# Storage paths (local PC)
# ─────────────────────────────────────────────────────────────
DATA_DIR=./var/data                   # parquet caches, raw news dumps, etc.
MODEL_DIR=./var/models                # trained model artifacts
LOG_DIR=./var/logs                    # JSON logs

# ─────────────────────────────────────────────────────────────
# Universe (overridable per environment)
# ─────────────────────────────────────────────────────────────
KR_INDICES=KOSPI200,KOSDAQ150
US_INDICES=SP500,NASDAQ100
